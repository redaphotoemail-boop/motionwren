# Existing owner access
FRAME_MOTION_ADMIN_EMAILS=owner@example.com

# Required for unattended customer generation and provider webhooks
REPLICATE_API_TOKEN=

# Required to activate paid checkout and credit enforcement
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_FIVE_PACK=
STRIPE_PRICE_PRO=

# Optional transactional email; in-app notifications work without it
RESEND_API_KEY=
FRAME_MOTION_FROM_EMAIL=MotionWren <delivery@example.com>

# Future controlled FFmpeg compositor; the external processor remains fallback
COMPOSITOR_API_URL=
COMPOSITOR_API_SECRET=
COMPOSITOR_API_VERSION=fm-ffmpeg-1.0.0
